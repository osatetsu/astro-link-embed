---
// Embed.astro is the sole owner of layout & styles.
// It receives the parsed embed data as Astro props.
const {
  title = '',
  url = '',
  image = '',
  description = '',
} = Astro.props;
---

<article class="embed">
  <a class="embed__link" href={url} target="_blank" rel="noopener noreferrer">
    <div class="embed__media">
      <img src={image} alt={title} loading="lazy" decoding="async" />
    </div>
    <div class="embed__body">
      <h3 class="embed__title">{title}</h3>
      <p class="embed__description">{description}</p>
    </div>
  </a>
</article>

<style>
  .embed {
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    overflow: hidden;
    max-width: 600px;
    margin: 1rem 0;
  }
  .embed__link {
    text-decoration: none;
    color: inherit;
    display: flex;
  }
  .embed__media {
    flex: 0 0 150px;
  }
  .embed__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .embed__body {
    padding: 1rem;
    flex: 1;
  }
  .embed__title {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    font-weight: 600;
  }
  .embed__description {
    margin: 0;
    font-size: 0.9rem;
    color: #666;
  }
</style>
